    <org.eventb.core.invariant name="/" org.eventb.core.label="inv5" org.eventb.core.predicate="∀c · c∈CLOCK ⇒ ( chi(c↦1)=0 ∧ (&#13;&#10;&#9; ∀i · i ∈ dom(delta) ⇒ (&#13;&#10;&#9;&#9;(c∈delta(i) ⇒ chi(c↦i+1) = chi(c↦i) +1) ∧&#13;&#10;&#9;&#9;(c∉delta(i) ⇒ chi(c↦i+1) = chi(c↦i)) )))&#13;&#10;"/>
