<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
    <org.eventb.core.event name="'" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="INITIALISATION">
        <org.eventb.core.action name="'" org.eventb.core.assignment="ctr≔0" org.eventb.core.label="act3"/>
    </org.eventb.core.event>
    <org.eventb.core.refinesMachine name="(" org.eventb.core.target="CCSLinfimum"/>
    <org.eventb.core.event name=")" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="Schedule">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Schedule"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd3" org.eventb.core.predicate="(ctr=0 ⇒ Int2Bool(clock_set(c1)) = bool(clock_set(c2)=1 ∨ clock_set(c3)=1))&#13;&#10;∧ (ctr&gt;0 ⇒ clock_set(c1) = clock_set(c2))&#13;&#10;∧ (ctr&lt;0 ⇒ clock_set(c1) = clock_set(c3))"/>
        <org.eventb.core.action name=")" org.eventb.core.assignment="ctr ≔ ctr+clock_set(c2) − clock_set(c3)" org.eventb.core.label="act3"/>
        <org.eventb.core.guard name="*" org.eventb.core.label="grd4" org.eventb.core.predicate="ctr+clock_set(c2) − clock_set(c3)∈INT_IMP"/>
    </org.eventb.core.event>
    <org.eventb.core.variable name="*" org.eventb.core.identifier="chi"/>
    <org.eventb.core.variable name="+" org.eventb.core.identifier="delta"/>
    <org.eventb.core.variable name="," org.eventb.core.identifier="ctr"/>
    <org.eventb.core.invariant name="-" org.eventb.core.label="inv1" org.eventb.core.predicate="ctr ∈ INT_IMP"/>
    <org.eventb.core.invariant name="." org.eventb.core.label="inv2" org.eventb.core.predicate="ctr = chi(c2↦(min(ℕ1 ∖ dom(delta)))) − chi(c3↦(min(ℕ1 ∖ dom(delta))))"/>
    <org.eventb.core.invariant name="/" org.eventb.core.label="inv3" org.eventb.core.predicate="∀clock_set·(clock_set ∈ CLOCK → {0,1} ⇒ (&#13;&#10;&#9;(∀i · i ∈ ran(dom(chi ∪ {(c↦s)↦n∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧ n=chi(c↦(s−1))+clock_set(c) })) ⇒&#13;&#10;&#9;&#9;&#9;&#9;&#9;(chi ∪ {(c↦s)↦n∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧ n=chi(c↦(s−1))+clock_set(c) })(c2↦i)− (chi ∪ {(c↦s)↦n∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧ n=chi(c↦(s−1))+clock_set(c) })(c3↦ i) ∈ INT_IMP ∧&#13;&#10;&#9;&#9; &#9;     &#9;(chi ∪ {(c↦s)↦n∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧ n=chi(c↦(s−1))+clock_set(c) })(c1↦ i) = max({(chi ∪ {(c↦s)↦n∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧ n=chi(c↦(s−1))+clock_set(c) })(c2↦i), (chi ∪ {(c↦s)↦n∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧ n=chi(c↦(s−1))+clock_set(c) })(c3↦ i)})) &#13;&#10;&#9;⇒ &#13;&#10;&#9;( (ctr=0 ⇒ Int2Bool(clock_set(c1)) = bool(clock_set(c2)=1 ∨ clock_set(c3)=1))&#13;&#10;&#9;∧ (ctr&gt;0 ⇒ clock_set(c1) = clock_set(c2))&#13;&#10;&#9;∧ (ctr&lt;0 ⇒ clock_set(c1) = clock_set(c3)))&#13;&#10;&#9;)&#13;&#10;) " org.eventb.core.theorem="true"/>
    <org.eventb.core.seesContext name="0" org.eventb.core.target="CCSL_ctx"/>
</org.eventb.core.machineFile>
