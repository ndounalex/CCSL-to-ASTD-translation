<org.eventb.core.scMachineFile org.eventb.core.accurate="true" org.eventb.core.configuration="org.eventb.core.fwd">
    <org.eventb.core.scRefinesMachine name="'" org.eventb.core.scTarget="/proofAlexCCSL/CCSLcausality.bcm" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.refinesMachine#)"/>
    <org.eventb.core.scSeesContext name="(" org.eventb.core.scTarget="/proofAlexCCSL/CCSL_ctx.bcc" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.seesContext#("/>
    <org.eventb.core.scInternalContext name="CCSL_ctx">
        <org.eventb.core.scAxiom name="'" org.eventb.core.label="axm1" org.eventb.core.predicate="{c1,c2,c3}⊆CLOCK" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm1" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAxiom name="(" org.eventb.core.label="axm2" org.eventb.core.predicate="c1≠c2∧c2≠c3∧c3≠c1" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#set2" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAxiom name=")" org.eventb.core.label="axm4" org.eventb.core.predicate="maxint∈ℕ" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm2" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAxiom name="*" org.eventb.core.label="axm5" org.eventb.core.predicate="minint&lt;0" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm3" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAxiom name="+" org.eventb.core.label="axm6" org.eventb.core.predicate="INT_IMP=minint ‥ maxint" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm4" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAxiom name="," org.eventb.core.label="axm12" org.eventb.core.predicate="NAT_IMP=0 ‥ maxint" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm5" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAxiom name="-" org.eventb.core.label="axm13" org.eventb.core.predicate="NAT1_IMP=NAT_IMP ∖ {0}" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm6" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAxiom name="." org.eventb.core.label="axm15" org.eventb.core.predicate="maxint&gt;0" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm7" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAxiom name="/" org.eventb.core.label="axm16" org.eventb.core.predicate="Int2Bool=(λi⦂ℤ·i∈ℤ ∣ bool(i≠0))" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm8" org.eventb.core.theorem="false"/>
        <org.eventb.core.scCarrierSet name="CLOCK" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.carrierSet#set1" org.eventb.core.type="ℙ(CLOCK)"/>
        <org.eventb.core.scConstant name="INT_IMP" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.constant#cst6" org.eventb.core.type="ℙ(ℤ)"/>
        <org.eventb.core.scConstant name="NAT1_IMP" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.constant#cst8" org.eventb.core.type="ℙ(ℤ)"/>
        <org.eventb.core.scConstant name="c1" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.constant#cst1" org.eventb.core.type="CLOCK"/>
        <org.eventb.core.scConstant name="c2" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.constant#cst2" org.eventb.core.type="CLOCK"/>
        <org.eventb.core.scConstant name="c3" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.constant#cst3" org.eventb.core.type="CLOCK"/>
        <org.eventb.core.scConstant name="Int2Bool" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.constant#cst9" org.eventb.core.type="ℙ(ℤ×BOOL)"/>
        <org.eventb.core.scConstant name="NAT_IMP" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.constant#cst7" org.eventb.core.type="ℙ(ℤ)"/>
        <org.eventb.core.scConstant name="maxint" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.constant#cst5" org.eventb.core.type="ℤ"/>
        <org.eventb.core.scConstant name="minint" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.constant#cst4" org.eventb.core.type="ℤ"/>
    </org.eventb.core.scInternalContext>
    <org.eventb.core.scInvariant name="CCSL_cty" org.eventb.core.label="inv1" org.eventb.core.predicate="chi∈CLOCK × ℕ1 ⇸ ℕ" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.invariant#*" org.eventb.core.theorem="false"/>
    <org.eventb.core.scInvariant name="CCSL_ctz" org.eventb.core.label="inv2" org.eventb.core.predicate="delta∈ℕ1 ⇸ ℙ(CLOCK)" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.invariant#+" org.eventb.core.theorem="false"/>
    <org.eventb.core.scInvariant name="CCSL_ct{" org.eventb.core.label="inv3" org.eventb.core.predicate="∃n⦂ℤ·n∈ℕ∧dom(delta)∪{0}=0 ‥ n" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.invariant#-" org.eventb.core.theorem="false"/>
    <org.eventb.core.scInvariant name="CCSL_ct|" org.eventb.core.label="inv4" org.eventb.core.predicate="∃n⦂ℤ·n∈ℕ∧dom(chi)=CLOCK × 1 ‥ n∧n=min(ℕ1 ∖ dom(delta))" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.invariant#." org.eventb.core.theorem="false"/>
    <org.eventb.core.scInvariant name="CCSL_ct}" org.eventb.core.label="inv5" org.eventb.core.predicate="∀c⦂CLOCK·c∈CLOCK⇒chi(c ↦ 1)=0∧(∀i⦂ℤ·i∈dom(delta)⇒(c∈delta(i)⇒chi(c ↦ i+1)=chi(c ↦ i)+1)∧(c∉delta(i)⇒chi(c ↦ i+1)=chi(c ↦ i)))" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.invariant#\/" org.eventb.core.theorem="false"/>
    <org.eventb.core.scInvariant name="CCSL_ct~" org.eventb.core.label="inv6" org.eventb.core.predicate="∀c⦂CLOCK·∀i⦂ℤ·∀j⦂ℤ·c ↦ i∈dom(chi)∧c ↦ j∈dom(chi)∧i≤j⇒chi(c ↦ i)≤chi(c ↦ j)" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.invariant#1" org.eventb.core.theorem="false"/>
    <org.eventb.core.scInvariant name="CCSL_cu'" org.eventb.core.label="inv1" org.eventb.core.predicate="∀n⦂ℤ·n∈ran(dom(chi))⇒chi(c1 ↦ n)≥chi(c2 ↦ n)" org.eventb.core.source="/proofAlexCCSL/CCSLcausality.bum|org.eventb.core.machineFile#CCSLcausality|org.eventb.core.invariant#," org.eventb.core.theorem="false"/>
    <org.eventb.core.scInvariant name="CCSL_cu(" org.eventb.core.label="inv2" org.eventb.core.predicate="ctr=chi(c1 ↦ min(ℕ1 ∖ dom(delta))) − chi(c2 ↦ min(ℕ1 ∖ dom(delta)))" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.invariant#\/" org.eventb.core.theorem="false"/>
    <org.eventb.core.scInvariant name="CCSL_cu)" org.eventb.core.label="inv1" org.eventb.core.predicate="∀clock_set⦂ℙ(CLOCK×ℤ)·clock_set∈CLOCK → {0,1}⇒((∀n⦂ℤ·n∈1 ‥ min(ℕ1 ∖ dom(delta))+1⇒(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c1 ↦ n) − (chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c2 ↦ n)∈INT_IMP∧(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c1 ↦ n)≥(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c2 ↦ n))⇒ctr+clock_set(c1) − clock_set(c2)≥0)" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.invariant#." org.eventb.core.theorem="true"/>
    <org.eventb.core.scVariable name="chi" org.eventb.core.abstract="true" org.eventb.core.concrete="true" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.variable#*" org.eventb.core.type="ℙ(CLOCK×ℤ×ℤ)"/>
    <org.eventb.core.scVariable name="ctr" org.eventb.core.abstract="false" org.eventb.core.concrete="true" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.variable#," org.eventb.core.type="ℤ"/>
    <org.eventb.core.scVariable name="delta" org.eventb.core.abstract="true" org.eventb.core.concrete="true" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.variable#+" org.eventb.core.type="ℙ(ℤ×ℙ(CLOCK))"/>
    <org.eventb.core.scEvent name="CCSL_cu*" org.eventb.core.accurate="true" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="INITIALISATION" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.event#'">
        <org.eventb.core.scRefinesEvent name="'" org.eventb.core.scTarget="/proofAlexCCSL/CCSLcausality.bcm|org.eventb.core.scMachineFile#CCSLcausality|org.eventb.core.scEvent#CCSL_cu(" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.event#'"/>
        <org.eventb.core.scAction name="'" org.eventb.core.assignment="chi ≔ CLOCK × {1} × {0}" org.eventb.core.label="act1" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.event#'|org.eventb.core.action#'"/>
        <org.eventb.core.scAction name="(" org.eventb.core.assignment="delta ≔ ∅ ⦂ ℙ(ℤ×ℙ(CLOCK))" org.eventb.core.label="act2" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.event#'|org.eventb.core.action#("/>
        <org.eventb.core.scAction name=")" org.eventb.core.assignment="ctr ≔ 0" org.eventb.core.label="act3" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.event#'|org.eventb.core.action#'"/>
    </org.eventb.core.scEvent>
    <org.eventb.core.scEvent name="CCSL_cu+" org.eventb.core.accurate="true" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="Schedule" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.event#-">
        <org.eventb.core.scRefinesEvent name="'" org.eventb.core.scTarget="/proofAlexCCSL/CCSLcausality.bcm|org.eventb.core.scMachineFile#CCSLcausality|org.eventb.core.scEvent#CCSL_cu)" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.event#-|org.eventb.core.refinesEvent#'"/>
        <org.eventb.core.scGuard name="'" org.eventb.core.label="grd1" org.eventb.core.predicate="clock_set∈CLOCK → {0,1}" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.event#0|org.eventb.core.guard#(" org.eventb.core.theorem="false"/>
        <org.eventb.core.scGuard name="clock_sew" org.eventb.core.label="grd2" org.eventb.core.predicate="∀n⦂ℤ·n∈1 ‥ min(ℕ1 ∖ dom(delta))+1⇒(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c1 ↦ n)≥(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c2 ↦ n)" org.eventb.core.source="/proofAlexCCSL/CCSLcausality.bum|org.eventb.core.machineFile#CCSLcausality|org.eventb.core.event#+|org.eventb.core.guard#(" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAction name="clock_seu" org.eventb.core.assignment="delta ≔ delta∪{min(ℕ1 ∖ dom(delta)) ↦ dom(clock_set ▷ {1})}" org.eventb.core.label="act1" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.event#0|org.eventb.core.action#)"/>
        <org.eventb.core.scAction name="clock_sev" org.eventb.core.assignment="chi ≔ chi∪{c⦂CLOCK,s⦂ℤ,n⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧n=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ n}" org.eventb.core.label="act2" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.event#0|org.eventb.core.action#*"/>
        <org.eventb.core.scParameter name="clock_set" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.event#0|org.eventb.core.parameter#'" org.eventb.core.type="ℙ(CLOCK×ℤ)"/>
        <org.eventb.core.scGuard name="clock_sex" org.eventb.core.label="grd3" org.eventb.core.predicate="ctr+clock_set(c1) − clock_set(c2)≥0" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.event#-|org.eventb.core.guard#(" org.eventb.core.theorem="false"/>
        <org.eventb.core.scGuard name="clock_sey" org.eventb.core.label="grd4" org.eventb.core.predicate="ctr+clock_set(c1) − clock_set(c2)∈NAT_IMP" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.event#-|org.eventb.core.guard#)" org.eventb.core.theorem="false"/>
        <org.eventb.core.scAction name="clock_sez" org.eventb.core.assignment="ctr ≔ ctr+clock_set(c1) − clock_set(c2)" org.eventb.core.label="act3" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.event#-|org.eventb.core.action#*"/>
    </org.eventb.core.scEvent>
