<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
    <org.eventb.core.event name="'" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="INITIALISATION">
        <org.eventb.core.action name="'" org.eventb.core.assignment="ctr ≔ 0" org.eventb.core.label="act3"/>
    </org.eventb.core.event>
    <org.eventb.core.seesContext name="(" org.eventb.core.target="CCSL_ctx"/>
    <org.eventb.core.refinesMachine name=")" org.eventb.core.target="CCSLcausality"/>
    <org.eventb.core.variable name="*" org.eventb.core.identifier="chi"/>
    <org.eventb.core.variable name="+" org.eventb.core.identifier="delta"/>
    <org.eventb.core.variable name="," org.eventb.core.identifier="ctr"/>
    <org.eventb.core.event name="-" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="Schedule">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Schedule"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd3" org.eventb.core.predicate="(ctr + clock_set(c1) − clock_set(c2)) ≥ 0"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd4" org.eventb.core.predicate="ctr + clock_set(c1) − clock_set(c2) ∈ NAT_IMP"/>
        <org.eventb.core.action name="*" org.eventb.core.assignment="ctr ≔ ctr + clock_set(c1) − clock_set(c2) " org.eventb.core.label="act3"/>
    </org.eventb.core.event>
    <org.eventb.core.invariant name="/" org.eventb.core.label="inv2" org.eventb.core.predicate="ctr = chi(c1↦(min(ℕ1 ∖ dom(delta)))) − chi(c2↦(min(ℕ1 ∖ dom(delta))))"/>
    <org.eventb.core.invariant name="." org.eventb.core.label="inv1" org.eventb.core.predicate=" ∀clock_set · clock_set ∈ CLOCK → {0,1} ⇒ (&#13;&#10;&#9;(∀n · n∈1‥(min(ℕ1 ∖ dom(delta))+1) ⇒ &#13;&#10;&#9;&#9;(chi ∪ {(c↦s)↦x∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧ &#13;&#10;&#9;&#9;&#9;&#9;&#9;x=chi(c↦(s−1))+clock_set(c) })(c1↦ n) &#13;&#10;&#9;&#9;− (chi ∪ {(c↦s)↦x∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧&#13;&#10;&#9;&#9;&#9;&#9;&#9;x=chi(c↦(s−1))+clock_set(c) })(c2↦ n)∈ INT_IMP ∧ &#13;&#10;&#9;&#9;(chi ∪ {(c↦s)↦x∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧&#13;&#10;&#9;&#9;&#9;&#9;&#9;x=chi(c↦(s−1))+clock_set(c) })(c1↦ n) &#13;&#10;&#9;&#9;≥ &#9;&#13;&#10;&#9;&#9;(chi ∪ {(c↦s)↦x∣ c ∈ CLOCK ∧ s=(min(ℕ1 ∖ dom(delta))+1) ∧ &#13;&#10;&#9;&#9;&#9;&#9;&#9;x=chi(c↦(s−1))+clock_set(c) })(c2↦ n)&#13;&#10;&#9;)&#13;&#10;&#9;⇒&#13;&#10;&#9;&#9;((ctr + clock_set(c1) − clock_set(c2)) ≥ 0) &#13;&#10;)" org.eventb.core.theorem="true"/>
</org.eventb.core.machineFile>
