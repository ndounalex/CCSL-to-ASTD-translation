        <org.eventb.core.poPredicate name="NAT1_IMU" org.eventb.core.predicate="INT_IMP=minint ‥ maxint" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm4"/>
