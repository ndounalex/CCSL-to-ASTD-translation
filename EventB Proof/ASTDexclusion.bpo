        <org.eventb.core.poPredicate name="SEQHYQ" org.eventb.core.predicate="∀clock_set⦂ℙ(CLOCK×ℤ)·clock_set∈CLOCK → {0,1}⇒(∀n⦂ℤ·ℕ1 ∖ dom(delta)≠(∅ ⦂ ℙ(ℤ))∧(∃b⦂ℤ·∀x⦂ℤ·x∈ℕ1 ∖ dom(delta)⇒b≤x)∧(n∈dom(delta∪{min(ℕ1 ∖ dom(delta)) ↦ dom(clock_set ▷ {1})})⇒delta∪{min(ℕ1 ∖ dom(delta)) ↦ dom(clock_set ▷ {1})}∈ℤ ⇸ ℙ(CLOCK)∧(c1∉(delta∪{min(ℕ1 ∖ dom(delta)) ↦ dom(clock_set ▷ {1})})(n)∨(ℕ1 ∖ dom(delta)≠(∅ ⦂ ℙ(ℤ))∧(∃b⦂ℤ·∀x⦂ℤ·x∈ℕ1 ∖ dom(delta)⇒b≤x)∧n∈dom(delta∪{min(ℕ1 ∖ dom(delta)) ↦ dom(clock_set ▷ {1})})∧delta∪{min(ℕ1 ∖ dom(delta)) ↦ dom(clock_set ▷ {1})}∈ℤ ⇸ ℙ(CLOCK)))))∧((∀n⦂ℤ·n∈dom(delta∪{min(ℕ1 ∖ dom(delta)) ↦ dom(clock_set ▷ {1})})⇒c1∉(delta∪{min(ℕ1 ∖ dom(delta)) ↦ dom(clock_set ▷ {1})})(n)∨c2∉(delta∪{min(ℕ1 ∖ dom(delta)) ↦ dom(clock_set ▷ {1})})(n))⇒c1∈dom(clock_set)∧clock_set∈CLOCK ⇸ ℤ∧(clock_set(c1)=0∨(c2∈dom(clock_set)∧clock_set∈CLOCK ⇸ ℤ)))" org.eventb.core.source="/proofAlexCCSL/ASTDexclusion.bum|org.eventb.core.machineFile#ASTDexclusion|org.eventb.core.invariant#inv1"/>
