        <org.eventb.core.poPredicate name="NAT1_IMR" org.eventb.core.predicate="c1≠c2∧c2≠c3∧c3≠c1" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#set2"/>
