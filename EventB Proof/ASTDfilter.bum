<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
    <org.eventb.core.seesContext name="element1" org.eventb.core.target="filter_ctx"/>
    <org.eventb.core.variable name="var1" org.eventb.core.identifier="chi"/>
    <org.eventb.core.variable name="var2" org.eventb.core.identifier="delta"/>
    <org.eventb.core.variable name="var3" org.eventb.core.identifier="ctr"/>
    <org.eventb.core.invariant name="inv1" org.eventb.core.label="inv1" org.eventb.core.predicate="ctr ∈ INT_IMP"/>
    <org.eventb.core.invariant name="inv2" org.eventb.core.label="inv2" org.eventb.core.predicate="ctr = chi(c2↦(min(ℕ1 ∖ dom(delta)))) mod card(w) "/>
    <org.eventb.core.invariant name="inv3" org.eventb.core.label="inv3" org.eventb.core.predicate="∀clock_set·(clock_set ∈ CLOCK → {0,1} ⇒ (&#13;&#10;&#9;(∀n · n∈dom(delta ∪ {(min(ℕ1 ∖ dom(delta))) ↦ dom(clock_set ▷ {1})}) ⇒ (&#13;&#10;c1 ∈ (delta ∪ {(min(ℕ1 ∖ dom(delta))) ↦ dom(clock_set ▷ {1})})(n) ⇔ (c2 ∈ (delta ∪ {(min(ℕ1 ∖ dom(delta))) ↦ dom(clock_set ▷ {1})})(n) ∧ w((chi(c2↦ n) mod (card(w))))=1) ))&#9;&#13;&#10;⇒ &#13;&#10;&#9;( (clock_set(c1)=1 ⇔ (clock_set(c2)=1 ∧ (w(ctr) = 1))))&#9;)&#13;&#10;) " org.eventb.core.theorem="true"/>
    <org.eventb.core.event name="evt1" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="INITIALISATION">
        <org.eventb.core.action name="'" org.eventb.core.assignment="ctr≔0" org.eventb.core.label="act3"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="evt2" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="Schedule">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Schedule"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd3" org.eventb.core.predicate="clock_set(c1)=1 ⇔ (clock_set(c2)=1 ∧ (w(ctr) = 1))"/>
        <org.eventb.core.action name=")" org.eventb.core.assignment="ctr ≔ (ctr+ clock_set(c2))mod card(w)" org.eventb.core.label="act3"/>
    </org.eventb.core.event>
    <org.eventb.core.refinesMachine name="element2" org.eventb.core.target="CCSLfilter"/>
</org.eventb.core.machineFile>
