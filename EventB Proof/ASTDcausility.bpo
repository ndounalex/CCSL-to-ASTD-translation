        <org.eventb.core.poPredicate name="NAT1_IMW" org.eventb.core.predicate="NAT1_IMP=NAT_IMP ∖ {0}" org.eventb.core.source="/proofAlexCCSL/CCSL_ctx.buc|org.eventb.core.contextFile#CCSL_ctx|org.eventb.core.axiom#axm6"/>
