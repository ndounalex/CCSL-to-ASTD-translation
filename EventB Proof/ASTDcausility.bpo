        <org.eventb.core.poPredicate name="delte" org.eventb.core.predicate="∃n⦂ℤ·n∈ℕ∧dom(chi)=CLOCK × 1 ‥ n∧n=min(ℕ1 ∖ dom(delta))" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.invariant#."/>
        <org.eventb.core.poPredicate name="deltf" org.eventb.core.predicate="∀c⦂CLOCK·c∈CLOCK⇒chi(c ↦ 1)=0∧(∀i⦂ℤ·i∈dom(delta)⇒(c∈delta(i)⇒chi(c ↦ i+1)=chi(c ↦ i)+1)∧(c∉delta(i)⇒chi(c ↦ i+1)=chi(c ↦ i)))" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.invariant#\/"/>
        <org.eventb.core.poPredicate name="deltg" org.eventb.core.predicate="∀c⦂CLOCK·∀i⦂ℤ·∀j⦂ℤ·c ↦ i∈dom(chi)∧c ↦ j∈dom(chi)∧i≤j⇒chi(c ↦ i)≤chi(c ↦ j)" org.eventb.core.source="/proofAlexCCSL/CCSL_generic.bum|org.eventb.core.machineFile#CCSL_generic|org.eventb.core.invariant#1"/>
