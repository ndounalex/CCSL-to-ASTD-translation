        <org.eventb.core.poPredicate name="SEQHYQ" org.eventb.core.predicate="∀clock_set⦂ℙ(CLOCK×ℤ)·clock_set∈CLOCK → {0,1}⇒(∀n⦂ℤ·ℕ1 ∖ dom(delta)≠(∅ ⦂ ℙ(ℤ))∧(∃b⦂ℤ·∀x⦂ℤ·x∈ℕ1 ∖ dom(delta)⇒b≤x)∧(n∈1 ‥ min(ℕ1 ∖ dom(delta))+1⇒(∀c⦂CLOCK,s⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1⇒c ↦ s − 1∈dom(chi)∧chi∈CLOCK × ℤ ⇸ ℤ∧c∈dom(clock_set)∧clock_set∈CLOCK ⇸ ℤ)∧c1 ↦ n∈dom(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})∧chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x}∈CLOCK × ℤ ⇸ ℤ∧c2 ↦ n∈dom(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})))∧((∀n⦂ℤ·n∈1 ‥ min(ℕ1 ∖ dom(delta))+1⇒(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c1 ↦ n) − (chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c2 ↦ n)∈INT_IMP∧(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c1 ↦ n)≥(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c2 ↦ n))⇒c1∈dom(clock_set)∧clock_set∈CLOCK ⇸ ℤ∧c2∈dom(clock_set))" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.invariant#."/>
