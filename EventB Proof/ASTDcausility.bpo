        <org.eventb.core.poPredicate name="SEQHYQ" org.eventb.core.predicate="∀clock_set⦂ℙ(CLOCK×ℤ)·clock_set∈CLOCK → {0,1}⇒((∀n⦂ℤ·n∈1 ‥ min(ℕ1 ∖ dom(delta))+1⇒(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c1 ↦ n) − (chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c2 ↦ n)∈INT_IMP∧(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c1 ↦ n)≥(chi∪{c⦂CLOCK,s⦂ℤ,x⦂ℤ·c∈CLOCK∧s=min(ℕ1 ∖ dom(delta))+1∧x=chi(c ↦ s − 1)+clock_set(c) ∣ c ↦ s ↦ x})(c2 ↦ n))⇒ctr+clock_set(c1) − clock_set(c2)≥0)" org.eventb.core.source="/proofAlexCCSL/ASTDcausility.bum|org.eventb.core.machineFile#ASTDcausility|org.eventb.core.invariant#."/>
